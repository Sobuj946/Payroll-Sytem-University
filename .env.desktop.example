# Copy this file to .env on the computer that runs the system, then edit the marked lines.
APP_NAME="Payroll Management System"
APP_ENV=production
APP_KEY=                      # fill with: php artisan key:generate
APP_DEBUG=false
APP_URL=http://127.0.0.1:8123

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payroll_pms
DB_USERNAME=pms
DB_PASSWORD=change-this-password      # use the password you gave the database user

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
